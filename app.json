{
    "expo": {
        "name": "WorldItSocialNetwork",
        "scheme": "worlditsocialnetwork",
        "slug": "WorldItSocialNetwork",
        "version": "1.0.0",
        "orientation": "portrait",
        "icon": "./assets/icon.png",
        "userInterfaceStyle": "light",
        "newArchEnabled": true,
        "splash": {
            "image": "./assets/splash-icon.png",
            "resizeMode": "contain",
            "backgroundColor": "#ffffff"
        },
        "ios": {
            "supportsTablet": true
        },
        "android": {
            "adaptiveIcon": {
                "foregroundImage": "./assets/adaptive-icon.png",
                "backgroundColor": "#ffffff"
            },
            "softwareKeyboardLayoutMode": "pan",
            "package": "com.serjik.WorldItSocialNetwork"
        },
        "web": {
            "build": {
                "babel": {
                    "include": []
                },
                "output": "web-build",
                "publicPath": "./"
            },
            "bundler": "metro",
            "favicon": "./assets/favicon.png"
        },
        "plugins": ["expo-router", "@react-native-community/datetimepicker"],
        "extra": {
            "router": {},
            "eas": {
                "projectId": "23b10fb5-88c1-4207-bcca-a7d748a340e7"
            }
        },
        "build": {
            "development": {
                "developmentClient": true,
                "distribution": "internal",
                "android": {
                    "buildType": "apk"
                }
            }
        }
    }
}
